# Copy to .env to override. Every value below already has the same default in docker-compose.yml,
# so `docker compose up` works without a .env file. Demo values only - never real credentials.

# Host ports
WEB_PORT_YII=8080
WEB_PORT_NODE=3001
WEB_PORT_REACT=5173
DB_PORT_HOST=5433

# PostgreSQL
POSTGRES_PASSWORD=postgres_dev
APP_DB_NAME=simrs
SIMRS_CORE_PASSWORD=simrs_core_dev
SIMRS_SERVICE_PASSWORD=simrs_service_dev

# Application
APP_ENV=prod
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

# Node -> Yii internal calls (X-Service-Token)
SERVICE_TOKEN=change-me-service-token

# Demo data
SEED_ON_START=true
SEED_USER_PASSWORD=Simrs#2026

# Access token lifetime (seconds)
JWT_TTL_SECONDS=3600

# Integration (Node <-> external lab). Demo values; MOCK_LIS_* simulate the external lab.
LIS_API_KEY=change-me-lis-key
MOCK_LIS_ENABLED=true
MOCK_LIS_DELAY_MS=2000
WORKER_ENABLED=true

# Dashboard aggregate cache (Node), seconds
DASHBOARD_CACHE_TTL_SECONDS=60
OUTBOX_BACKOFF_BASE_SECONDS=2
